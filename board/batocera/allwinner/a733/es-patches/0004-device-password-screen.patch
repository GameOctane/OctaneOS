diff --git a/es-app/src/guis/GuiDevicePassword.cpp b/es-app/src/guis/GuiDevicePassword.cpp
new file mode 100644
index 0000000..7c0c484
--- /dev/null
+++ b/es-app/src/guis/GuiDevicePassword.cpp
@@ -0,0 +1,93 @@
+#include "GuiDevicePassword.h"
+#include "guis/GuiMsgBox.h"
+#include "guis/GuiTextEditPopupKeyboard.h"
+#include "LocaleES.h"
+#include "Window.h"
+#include <cstdio>
+#include <string>
+
+static const size_t MIN_LENGTH = 8;   // the same limit the board script enforces
+
+static std::string trimLine(std::string s)
+{
+	while (!s.empty() && (s.back() == '\n' || s.back() == '\r' || s.back() == ' '))
+		s.pop_back();
+	return s;
+}
+
+static std::string runHelper(const std::string& arg)
+{
+	std::string out;
+	FILE* pipe = popen(("octane-device-password " + arg + " 2>/dev/null").c_str(), "r");
+	if (!pipe)
+		return out;
+	char line[128];
+	if (fgets(line, sizeof(line), pipe))
+		out = trimLine(line);
+	pclose(pipe);
+	return out;
+}
+
+// The password goes to the script on its standard input, never on a command line (a command line can be read by other programs).
+static bool storePassword(const std::string& password)
+{
+	FILE* pipe = popen("octane-device-password set >/dev/null 2>&1", "w");
+	if (!pipe)
+		return false;
+	fputs(password.c_str(), pipe);
+	fputs("\n", pipe);
+	return pclose(pipe) == 0;
+}
+
+std::string GuiDevicePassword::status()
+{
+	std::string s = runHelper("status");
+	return (s == "ask" || s == "set" || s == "remind" || s == "skipped" || s == "declined") ? s : "";
+}
+
+void GuiDevicePassword::openSetPassword(Window* window, const std::function<void()>& done)
+{
+	window->pushGui(new GuiTextEditPopupKeyboard(window, _("NEW DEVICE PASSWORD"), "",
+		[window, done](const std::string& first)
+		{
+			if (first.size() < MIN_LENGTH)
+			{
+				window->pushGui(new GuiMsgBox(window,
+					_("THE PASSWORD MUST BE AT LEAST") + std::string(" ") + std::to_string(MIN_LENGTH) + " " + _("CHARACTERS"), _("OK"), nullptr));
+				return;
+			}
+			window->pushGui(new GuiTextEditPopupKeyboard(window, _("TYPE IT AGAIN"), "",
+				[window, done, first](const std::string& second)
+				{
+					if (second != first)
+					{
+						window->pushGui(new GuiMsgBox(window, _("THE TWO PASSWORDS DO NOT MATCH. NOTHING WAS CHANGED."), _("OK"), nullptr));
+						return;
+					}
+					if (storePassword(first))
+					{
+						window->pushGui(new GuiMsgBox(window,
+							_("PASSWORD SET.") + std::string("\n") + _("USE IT WITH THE USER NAME root FOR SSH AND THE NETWORK FILE SHARE."),
+							_("OK"), [done] { if (done) done(); }));
+					}
+					else
+						window->pushGui(new GuiMsgBox(window, _("THE PASSWORD COULD NOT BE SAVED."), _("OK"), nullptr));
+				}, false, _("SET")));
+		}, false, _("NEXT")));
+}
+
+void GuiDevicePassword::askIfNeeded(Window* window)
+{
+	// "ask" = first start; "remind" = the player put it off and a week has passed.  Every other state shows nothing.
+	const std::string state = status();
+	if (state != "ask" && state != "remind")
+		return;
+
+	window->pushGui(new GuiMsgBox(window,
+		_("SET A DEVICE PASSWORD?") + std::string("\n\n") +
+		_("IT PROTECTS SSH AND THE NETWORK FILE SHARE. UNTIL YOU SET ONE, BOTH USE THE DEFAULT PASSWORD: linux.") + std::string("\n") +
+		_("YOU CAN ALSO DO THIS LATER IN MAIN MENU > SECURITY."),
+		_("SET PASSWORD"), [window] { GuiDevicePassword::openSetPassword(window, nullptr); },
+		_("LATER"), [] { runHelper("skip"); },
+		_("DON'T ASK AGAIN"), [] { runHelper("decline"); }));
+}
diff --git a/es-app/src/guis/GuiDevicePassword.h b/es-app/src/guis/GuiDevicePassword.h
new file mode 100644
index 0000000..c441518
--- /dev/null
+++ b/es-app/src/guis/GuiDevicePassword.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <functional>
+#include <string>
+
+class Window;
+
+// The device password (SSH and the network file share).  The work is done by the board script "octane-device-password"
+// (it reuses Batocera's own security setting); this file is only the questions.  On a system without that script nothing is shown.
+namespace GuiDevicePassword
+{
+	// "ask" (first-boot question), "remind" (put off, reminder due), "set", "skipped" (put off, not due), "declined" (never ask), or "" when the script is not installed.
+	std::string status();
+
+	// First-boot question.  Does nothing unless status() is "ask".  Safe to call on every start.
+	void askIfNeeded(Window* window);
+
+	// Type a new password twice and store it.  done() is called after a successful change (it may be empty).
+	void openSetPassword(Window* window, const std::function<void()>& done);
+}
