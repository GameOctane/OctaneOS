+void Window::setProfileBadge(const std::string& text)
+{
+	if (text == mProfileBadgeText && (mProfileBadge != nullptr) == !text.empty())
+		return;
+
+	delete mProfileBadge;
+	mProfileBadge = nullptr;
+	mProfileBadgeText = text;
+
+	if (!text.empty())
+		mProfileBadge = new GuiInfoPopup(this, text, 0, false);
+
+	layoutNotificationPopups();
+}
