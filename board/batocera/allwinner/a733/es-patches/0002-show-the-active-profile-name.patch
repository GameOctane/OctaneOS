+std::string GuiProfilesSettings::getActiveProfileLabel()
+{
+	std::string current;
+	FILE* f = fopen("/userdata/system/.batocera-profiles.current", "r");
+	if (f)
+	{
+		char line[256] = "";
+		if (fgets(line, sizeof(line), f))
+			current = line;
+		fclose(f);
+	}
+	while (!current.empty() && (current.back() == '\n' || current.back() == '\r' || current.back() == ' '))
+		current.pop_back();
+
+	bool anyNamed = false;
+	DIR* d = opendir("/userdata/profiles");
+	if (d)
+	{
+		struct dirent* e;
+		while ((e = readdir(d)) != nullptr)
+			if (e->d_name[0] != '.')
+			{
+				anyNamed = true;
+				break;
+			}
+		closedir(d);
+	}
+
+	if (!anyNamed && current.empty())
+		return "";
+	if (current.empty())
+		return profileDisplayName("/userdata/profiles/.default-retroachievements.conf", _("DEFAULT"));
+	return profileDisplayName("/userdata/profiles/" + current + "/retroachievements.conf", current);
+}
