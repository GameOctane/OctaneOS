 	case ApiSystem::THEMESDOWNLOADER:
 		return true;
 	case ApiSystem::RETROACHIVEMENTS:
-#ifdef CHEEVOS_DEV_LOGIN
+		// OctaneOS: always available, so the settings entry where the player types their own Web API key is reachable even
+		// without a built-in developer key (CHEEVOS_DEV_LOGIN).
 		return true;
-#endif
-		break;
 	case ApiSystem::KODI:
 		executables.push_back("kodi");
 		break;
--- a/es-app/src/guis/GuiRetroAchievementsSettings.cpp
+++ b/es-app/src/guis/GuiRetroAchievementsSettings.cpp
@@ -25,6 +25,8 @@
 	// retroachievements, username, password
 	addInputTextConfigRow(_("USERNAME"), "global.retroachievements.username", false);
