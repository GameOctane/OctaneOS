+
+	/* 8-bit data indicate rx capability */
+	u8 bcaps;
+
+	/* 40-bit data*/
+	u64 aksv;
+
+	/* 64-bit Pseudo random value */
+	u64 an;
+
+	/* 40-bit data*/
+	u64 bksv;
+
+	/* 64-bit after-calculate data */
+	u64 km;
+
+	/* 16-bit after-calculate data */
+	u32 r0;
+	u32 r0_prime;
