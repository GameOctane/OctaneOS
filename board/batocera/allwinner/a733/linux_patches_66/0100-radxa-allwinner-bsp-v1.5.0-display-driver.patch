+static void sunxi_dp_hdcp1_cal_km(struct sunxi_dptx_hdcp1_info *info)
+{
+	struct sunxi_dp_hdcp *hdcp = sunxi_hdcp1_info_to_sunxi_hdcp(info);
+
+	info->an = dptx_hdcp1_hw_get_an(hdcp->edp_hw);
