+
+	/* read pairing info */
+	memset(ekh_km_buf, 0, sizeof(ekh_km_buf));
+	if (edp_hw_aux_read(hdcp->edp_hw, HDCP2X_DPCD_EKH_KM_RD,
+			      HDCP2X_EKH_KM_RD_SIZE, &ekh_km_buf[0]) < 0)
+		return RET_FAIL;
+
+	/*fill ekh_km */
+	memcpy(info->pairing_info->ekh_km, ekh_km_buf, sizeof(ekh_km_buf));
