+static void trilinear_hdcp2_key_drvn_tx_aes_counter_reset(struct sunxi_edp_hw_desc *edp_hw)
+{
+	TR_SET_BITS(edp_hw, TR_HDCP_AES_COUNTER_RESET, 0, 1, 1);
+}
+
+static void trilinear_hdcp2_key_drvn_tx_reset(struct sunxi_edp_hw_desc *edp_hw)
+{
+	/* hdcp2_hw_tx_stream_cipher_write, disable stream cipher  */
+	trilinear_hdcp_encrypt_enable(edp_hw, false);
+
+	/* hdcp2_hw_tx_hardware_keys, disable hardware keys */
+	TR_SET_BITS(edp_hw, TR_HDCP_CIPHER_CONTROL, 0, 1, 0);
+
+	/* hdcp2_hw_tx_aes_ctr_reset */
+	trilinear_hdcp2_key_drvn_tx_aes_counter_reset(edp_hw);
+}
+
+static void trilinear_hdcp2_key_drvn_tx_src_select(struct sunxi_edp_hw_desc *edp_hw, u32 aes_sel)
+{
+	TR_SET_BITS(edp_hw, TR_HDCP_AES_INPUT_SELECT, 0, 3, aes_sel);
+}
+
+static void trilinear_hdcp2_write_lc128(struct sunxi_edp_hw_desc *edp_hw)
+{
+	TR_TOP_SET_BITS(edp_hw, TR_TOP_DP_MISC_RESERVED, 1, 1, 0x1);
+}
+
+static void trilinear_hdcp2_clear_lc128(struct sunxi_edp_hw_desc *edp_hw)
+{
+	TR_TOP_SET_BITS(edp_hw, TR_TOP_DP_MISC_RESERVED, 2, 1, 0x1);
+}
+
+static void trilinear_hdcp2_write_riv(struct sunxi_edp_hw_desc *edp_hw, char *riv)
+{
+    u32 reg_val;
+
+    reg_val = riv[3] << 24 | riv[2] << 16 | riv[1] << 8 | riv[0];
+    TR_WRITE(edp_hw, TR_HDCP_AN_31_0, reg_val);
+
+    reg_val = riv[7] << 24 | riv[6] << 16 | riv[5] << 8 | riv[4];
+    TR_WRITE(edp_hw, TR_HDCP_AN_63_32, reg_val);
+}
+
+static void trilinear_hdcp2_write_rrx(struct sunxi_edp_hw_desc *edp_hw, char *rrx)
+{
+    u32 reg_val;
+
+    reg_val = rrx[3] << 24 | rrx[2] << 16 | rrx[1] << 8 | rrx[0];
+    TR_WRITE(edp_hw, TR_HDCP_BKSV_31_0, reg_val);
+
+    reg_val = rrx[7] << 24 | rrx[6] << 16 | rrx[5] << 8 | rrx[4];
+    TR_WRITE(edp_hw, TR_HDCP_BKSV_63_32, reg_val);
+}
+
+static void trilinear_hdcp2_write_rtx(struct sunxi_edp_hw_desc *edp_hw, char *rtx)
+{
+    u32 reg_val;
+
+    reg_val = rtx[3] << 24 | rtx[2] << 16 | rtx[1] << 8 | rtx[0];
+    TR_WRITE(edp_hw, TR_HDCP_AN_31_0, reg_val);
+
+    reg_val = rtx[7] << 24 | rtx[6] << 16 | rtx[5] << 8 | rtx[4];
+    TR_WRITE(edp_hw, TR_HDCP_AN_63_32, reg_val);
+}
+
+static void trilinear_hdcp2_reset_rn(struct sunxi_edp_hw_desc *edp_hw)
+{
+	TR_WRITE(edp_hw, TR_HDCP_RN_31_0, 0);
+	TR_WRITE(edp_hw, TR_HDCP_RN_63_32, 0);
+}
+
+static void trilinear_hdcp2_key_drvn_tx_load(struct sunxi_edp_hw_desc *edp_hw,
+					     char *rrx, char *rtx)
+{
+	trilinear_hdcp2_write_rrx(edp_hw, rrx);
+	trilinear_hdcp2_write_rtx(edp_hw, rtx);
+	trilinear_hdcp2_reset_rn(edp_hw);
+}
+
+static void trilinear_hdcp2_write_km(struct sunxi_edp_hw_desc *edp_hw, char *km)
+{
+    u32 reg_val;
+
+    reg_val = km[3] << 24 | km[2] << 16 | km[1] << 8 | km[0];
+    TR_WRITE(edp_hw, TR_HDCP_KS_31_0, reg_val);
+
+    reg_val = km[7] << 24 | km[6] << 16 | km[5] << 8 | km[4];
+    TR_WRITE(edp_hw, TR_HDCP_KS_63_32, reg_val);
+
+    reg_val = km[11] << 24 | km[10] << 16 | km[9] << 8 | km[8];
+    TR_WRITE(edp_hw, TR_HDCP_KM_31_0, reg_val);
+
+    reg_val = km[15] << 24 | km[14] << 16 | km[13] << 8 | km[12];
+    TR_WRITE(edp_hw, TR_HDCP_KM_63_32, reg_val);
+}
+
+static void trilinear_hdcp2_write_ks(struct sunxi_edp_hw_desc *edp_hw, char *ks)
+{
+	trilinear_hdcp2_write_km(edp_hw, ks);
+}
+
+static void trilinear_hdcp2_read_dkey(struct sunxi_edp_hw_desc *edp_hw, char *dkey)
+{
+    u32 reg_val;
+
+    reg_val = TR_READ(edp_hw, TR_HDCP_M0_31_0);
+    dkey[3] = (reg_val >> 24) & 0xff;
+    dkey[2] = (reg_val >> 16) & 0xff;
+    dkey[1] = (reg_val >> 8) & 0xff;
+    dkey[0] = (reg_val) & 0xff;
+
+    reg_val = TR_READ(edp_hw, TR_HDCP_M0_63_32);
+    dkey[7] = (reg_val >> 24) & 0xff;
+    dkey[6] = (reg_val >> 16) & 0xff;
+    dkey[5] = (reg_val >> 8) & 0xff;
+    dkey[4] = (reg_val) & 0xff;
+
+    reg_val = TR_READ(edp_hw, TR_HDCP_AKSV_31_0);
+    dkey[11] = (reg_val >> 24) & 0xff;
+    dkey[10] = (reg_val >> 16) & 0xff;
+    dkey[9]  = (reg_val >> 8) & 0xff;
+    dkey[8]  = (reg_val) & 0xff;
+
+    reg_val = TR_READ(edp_hw, TR_HDCP_AKSV_63_32);
+    dkey[15] = (reg_val >> 24) & 0xff;
+    dkey[14] = (reg_val >> 16) & 0xff;
+    dkey[13] = (reg_val >> 8) & 0xff;
+    dkey[12] = (reg_val) & 0xff;
+}
+
+static void trilinear_hdcp2_aes_counter_inc(struct sunxi_edp_hw_desc *edp_hw)
+{
+	TR_WRITE(edp_hw, TR_HDCP_AES_COUNTER_ADV, 1);
+}
+
+static void trilinear_hdcp2_key_drvn_tx_kd_calc(struct sunxi_edp_hw_desc *edp_hw,
+						char *km, char *out_kd)
+{
+	char dkey0[DKEY_SIZE];
+	char dkey1[DKEY_SIZE];
+
+	/* generate dkey0 */
+	trilinear_hdcp2_write_km(edp_hw, km);
+	trilinear_hdcp2_read_dkey(edp_hw, dkey0);
+
+	/* generate dkey1 */
+	trilinear_hdcp2_aes_counter_inc(edp_hw);
+	trilinear_hdcp2_write_km(edp_hw, km);
+	trilinear_hdcp2_read_dkey(edp_hw, dkey1);
+
+	/* fill km to top hdcp driver */
+	memcpy(out_kd, dkey0, DKEY_SIZE);
+	memcpy(&out_kd[DKEY_SIZE], dkey1, DKEY_SIZE);
+}
+
+static void trilinear_hdcp2_get_kd(struct sunxi_edp_hw_desc *edp_hw, char *rrx,
+				   char *rtx, char *km, char *kd)
+{
+	trilinear_hdcp2_key_drvn_tx_reset(edp_hw);
+	trilinear_hdcp2_key_drvn_tx_src_select(edp_hw, AES_SEL_KEY_DERIVATION);
+	trilinear_hdcp2_key_drvn_tx_load(edp_hw, rrx, rtx);
+	trilinear_hdcp2_key_drvn_tx_kd_calc(edp_hw, km, kd);
+}
+
+static void trilinear_hdcp2_write_rn(struct sunxi_edp_hw_desc *edp_hw, char *rn)
+{
+    u32 reg_val;
+
+    reg_val = rn[3] << 24 | rn[2] << 16 | rn[1] << 8 | rn[0];
+    TR_WRITE(edp_hw, TR_HDCP_RN_31_0, reg_val);
+
+    reg_val = rn[7] << 24 | rn[6] << 16 | rn[5] << 8 | rn[4];
+    TR_WRITE(edp_hw, TR_HDCP_RN_63_32, reg_val);
+}
+
+static void trilinear_hdcp2_get_edkey_ks(struct sunxi_edp_hw_desc *edp_hw, char *km, char *rn,
+					 char *rrx, char *riv, char *ks, char *edkey_ks)
+{
+	char dkey2[DKEY_SIZE];
+
+	/* update rn, increase aes counter */
+	trilinear_hdcp2_write_rn(edp_hw, rn);
+	trilinear_hdcp2_aes_counter_inc(edp_hw);
+
+	/* generate dkey2 */
+	trilinear_hdcp2_write_km(edp_hw, km);
+	trilinear_hdcp2_read_dkey(edp_hw, dkey2);
+
+	memcpy(edkey_ks, ks, HDCP2X_KS_SIZE);
+	xor(&dkey2[8], rrx, 8);
+	xor(edkey_ks, dkey2, 16);
+
+}
+
+
+static void trilinear_hdcp2_cipher_disable(struct sunxi_edp_hw_desc *edp_hw)
+{
