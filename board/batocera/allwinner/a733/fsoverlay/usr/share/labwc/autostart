#!/bin/bash
# Starts EmulationStation when loading labwc
#
# OctaneOS: copy of the upstream Batocera file (package batocera-emulationstation, wayland/labwc/autostart) with one
# addition: the boot intro is played here, inside the compositor, right before EmulationStation (see usr/bin/octane-intro).
# S14labwc copies this file into /userdata/system/.config/labwc/ on every boot.

# Poll wlr-randr until it succeeds, which proves the compositor is ready.
# Add a 5s timeout to prevent an infinite loop if something is wrong.
timeout=5
waited=0
while ! wlr-randr > /dev/null 2>&1; do
  sleep 0.1
  waited=$(echo "$waited + 0.1" | bc)
  if [ "$(echo "$waited > $timeout" | bc)" -eq 1 ]; then
    echo "Timed out waiting for Wayland compositor to become ready." >> /userdata/system/logs/display.log
    exit 1
  fi
done

# Device quirks
BATOCERA_MODEL=$(batocera-model)
test -e "/usr/share/labwc/autostart_${BATOCERA_MODEL}" && "/usr/share/labwc/autostart_${BATOCERA_MODEL}"

# Now that we know the compositor is ready, launch our applications
/usr/bin/batocera-mouse hide > /dev/null 2>&1

# OctaneOS boot intro (returns when the video ends, or after at most 15 s)
/usr/bin/octane-intro > /dev/null 2>&1

/usr/bin/emulationstation-standalone > /dev/null 2>&1
