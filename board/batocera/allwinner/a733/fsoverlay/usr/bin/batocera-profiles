#!/bin/bash
# batocera-profiles — multi-user profile management
#
# Each profile lives in /userdata/profiles/<name>/  with:
#   saves/                   — SRAM save files (via /userdata/saves symlink)
#   states/                  — save states    (via /userdata/states symlink)
#   retroachievements.conf   — per-profile settings:
#                               username=, password=, token=
#                               ra_enabled= (0 or 1)
#                               display_name= (optional friendly label)
#
# Active profile tracked in /userdata/system/.batocera-profiles.current
# (empty = default; default profile data lives in .default/ and
#  .default-retroachievements.conf, both hidden from ls)

PROFILES_DIR="/userdata/profiles"
CURRENT_FILE="/userdata/system/.batocera-profiles.current"
RETROARCH_CFG="/userdata/system/configs/retroarch/retroarchcustom.cfg"
BATOCERA_CONF="/userdata/system/batocera.conf"

set_retroarch_key() {
    local key="$1" val="$2"
    touch "${RETROARCH_CFG}" 2>/dev/null || true
    if grep -q "^${key} = " "${RETROARCH_CFG}" 2>/dev/null; then
        sed -i "s|^${key} = .*|${key} = \"${val}\"|" "${RETROARCH_CFG}"
    else
        echo "${key} = \"${val}\"" >> "${RETROARCH_CFG}"
    fi
}

get_batocera_key() {
    grep "^${1}=" "${BATOCERA_CONF}" 2>/dev/null | cut -d= -f2-
}

# Read a single key=value field from a conf file
read_conf_field() {
    local file="$1" key="$2"
    grep "^${key}=" "${file}" 2>/dev/null | cut -d= -f2-
}

# Write all per-profile fields to a conf file, preserving display_name.
# Args: file username password token ra_enabled
write_profile_conf() {
    local file="$1" user="$2" pass="$3" token="$4" ra_enabled="$5"
    local dn
    dn=$(read_conf_field "${file}" "display_name")
    {
        printf 'username=%s\npassword=%s\ntoken=%s\nra_enabled=%s\n' \
            "${user}" "${pass}" "${token}" "${ra_enabled}"
        [ -n "${dn}" ] && printf 'display_name=%s\n' "${dn}"
    } > "${file}"
}

case "$1" in
    list)
        [ -d "${PROFILES_DIR}" ] && ls "${PROFILES_DIR}" 2>/dev/null || true
        ;;

    current)
        cat "${CURRENT_FILE}" 2>/dev/null || true
        ;;

    create)
        NAME="${2:-}"
        if [ -z "${NAME}" ]; then
            echo "usage: batocera-profiles create <name>" >&2
            exit 1
        fi
        mkdir -p "${PROFILES_DIR}/${NAME}/saves" "${PROFILES_DIR}/${NAME}/states"
        RA_USER=$(get_batocera_key "global.retroachievements.username")
        RA_PASS=$(get_batocera_key "global.retroachievements.password")
        RA_ENABLED=$(get_batocera_key "global.retroachievements")
        write_profile_conf \
            "${PROFILES_DIR}/${NAME}/retroachievements.conf" \
            "${RA_USER}" "${RA_PASS}" "" "${RA_ENABLED:-1}"
        echo "Profile '${NAME}' created."
        ;;

    switch)
        NAME="${2:-}"
        if [ -n "${NAME}" ] && [ ! -d "${PROFILES_DIR}/${NAME}" ]; then
            echo "Profile '${NAME}' not found" >&2
            exit 1
        fi

        # --- Save current profile's state before switching ---
        ACTIVE=$(cat "${CURRENT_FILE}" 2>/dev/null || true)
        CUR_USER=$(get_batocera_key "global.retroachievements.username")
        CUR_PASS=$(get_batocera_key "global.retroachievements.password")
        CUR_TOKEN=$(get_batocera_key "global.retroachievements.token")
        CUR_RA_ENABLED=$(get_batocera_key "global.retroachievements")
        if [ -n "${ACTIVE}" ] && [ -d "${PROFILES_DIR}/${ACTIVE}" ]; then
            write_profile_conf \
                "${PROFILES_DIR}/${ACTIVE}/retroachievements.conf" \
                "${CUR_USER}" "${CUR_PASS}" "${CUR_TOKEN}" "${CUR_RA_ENABLED:-1}"
        else
            write_profile_conf \
                "${PROFILES_DIR}/.default-retroachievements.conf" \
                "${CUR_USER}" "${CUR_PASS}" "${CUR_TOKEN}" "${CUR_RA_ENABLED:-1}"
        fi

        # --- Repoint saves/states symlinks ---
        # configgen hardcodes SAVES=/userdata/saves and overwrites savefile_directory
        # at every game launch; the symlink is the only effective redirect mechanism.
        # Auto-migrate: if /userdata/saves is still a real directory (fresh install or
        # pre-v0.6.8 device), move contents into .default/saves and replace with symlink.
        PROFILE_NAME="${NAME:-.default}"
        SAVE_TARGET="${PROFILES_DIR}/${PROFILE_NAME}/saves"
        STATE_TARGET="${PROFILES_DIR}/${PROFILE_NAME}/states"
        mkdir -p "${PROFILES_DIR}/.default/saves" "${PROFILES_DIR}/.default/states"
        if [ -d "/userdata/saves" ] && [ ! -L "/userdata/saves" ]; then
            cp -a /userdata/saves/. "${PROFILES_DIR}/.default/saves/" 2>/dev/null || true
            rm -rf /userdata/saves
            ln -s "${SAVE_TARGET}" /userdata/saves
        elif [ -L "/userdata/saves" ]; then
            rm -f /userdata/saves
            ln -s "${SAVE_TARGET}" /userdata/saves
        fi
        if [ -d "/userdata/states" ] && [ ! -L "/userdata/states" ]; then
            cp -a /userdata/states/. "${PROFILES_DIR}/.default/states/" 2>/dev/null || true
            rm -rf /userdata/states
            ln -s "${STATE_TARGET}" /userdata/states
        elif [ -L "/userdata/states" ]; then
            rm -f /userdata/states
            ln -s "${STATE_TARGET}" /userdata/states
        fi

        # --- Load target profile's credentials and settings ---
        if [ -n "${NAME}" ] && [ -f "${PROFILES_DIR}/${NAME}/retroachievements.conf" ]; then
            RA_CONF="${PROFILES_DIR}/${NAME}/retroachievements.conf"
        elif [ -z "${NAME}" ] && [ -f "${PROFILES_DIR}/.default-retroachievements.conf" ]; then
            RA_CONF="${PROFILES_DIR}/.default-retroachievements.conf"
        else
            RA_CONF=""
        fi

        if [ -n "${RA_CONF}" ]; then
            RA_USER=$(read_conf_field "${RA_CONF}" "username")
            RA_PASS=$(read_conf_field "${RA_CONF}" "password")
            RA_TOKEN=$(read_conf_field "${RA_CONF}" "token")
            RA_ENABLED=$(read_conf_field "${RA_CONF}" "ra_enabled")
        else
            RA_USER="" ; RA_PASS="" ; RA_TOKEN="" ; RA_ENABLED=""
        fi

        if [ -n "${RA_USER}" ]; then
            batocera-settings-set global.retroachievements.username "${RA_USER}"
            set_retroarch_key "cheevos_username" "${RA_USER}"
        fi
        if [ -n "${RA_PASS}" ]; then
            batocera-settings-set global.retroachievements.password "${RA_PASS}"
            set_retroarch_key "cheevos_password" "${RA_PASS}"
        fi
        # Always write token — empty string clears a stale one
        batocera-settings-set global.retroachievements.token "${RA_TOKEN}"
        set_retroarch_key "cheevos_token" "${RA_TOKEN}"
        # Restore RA enabled/disabled if the profile has a saved value
        if [ -n "${RA_ENABLED}" ]; then
            batocera-settings-set global.retroachievements "${RA_ENABLED}"
        fi

        echo "${NAME}" > "${CURRENT_FILE}"
        batocera-save-overlay
        echo "Switched to profile '${NAME:-DEFAULT}'."
        ;;

    delete)
        NAME="${2:-}"
        if [ -z "${NAME}" ]; then
            echo "usage: batocera-profiles delete <name>" >&2
            exit 1
        fi
        if [ ! -d "${PROFILES_DIR}/${NAME}" ]; then
            echo "Profile '${NAME}' not found" >&2
            exit 1
        fi
        rm -rf "${PROFILES_DIR}/${NAME}"
        ACTIVE=$(cat "${CURRENT_FILE}" 2>/dev/null || true)
        if [ "${ACTIVE}" = "${NAME}" ]; then
            echo "" > "${CURRENT_FILE}"
        fi
        echo "Profile '${NAME}' deleted."
        ;;

    *)
        echo "usage: batocera-profiles {list|current|create <name>|switch [<name>]|delete <name>}" >&2
        exit 1
        ;;
esac
