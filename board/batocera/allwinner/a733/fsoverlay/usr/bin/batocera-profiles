#!/bin/bash
# batocera-profiles — multi-user profile management
#
# Each profile lives in /userdata/profiles/<name>/  with:
#   saves/                   — SRAM save files (via /userdata/saves symlink)
#   states/                  — save states    (via /userdata/states symlink)
#   retroachievements.conf   — per-profile settings:
#                               username=, password=, token=
#                               apikey=  (the player's own RetroAchievements Web API key, retroachievements.org > Settings > Keys;
#                                         it belongs to the account, so it is saved and loaded with the username)
#                               ra_enabled= (0 or 1)
#                               display_name= (optional friendly label)
#
# Active profile tracked in /userdata/system/.batocera-profiles.current
# (empty = default; default profile data lives in .default/ and
#  .default-retroachievements.conf, both hidden from ls)

# The paths can be redirected with OCTANE_USERDATA (used by scripts/test-profiles.sh so the tests never touch a real /userdata).
USERDATA="${OCTANE_USERDATA:-/userdata}"
PROFILES_DIR="${USERDATA}/profiles"
CURRENT_FILE="${USERDATA}/system/.batocera-profiles.current"
RETROARCH_CFG="${USERDATA}/system/configs/retroarch/retroarchcustom.cfg"
BATOCERA_CONF="${USERDATA}/system/batocera.conf"

set_retroarch_key() {
    local key="$1" val="$2"
    touch "${RETROARCH_CFG}" 2>/dev/null || true
    if grep -q "^${key} = " "${RETROARCH_CFG}" 2>/dev/null; then
        sed -i "s|^${key} = .*|${key} = \"${val}\"|" "${RETROARCH_CFG}"
    else
        echo "${key} = \"${val}\"" >> "${RETROARCH_CFG}"
    fi
}

get_batocera_key() {
    grep "^${1}=" "${BATOCERA_CONF}" 2>/dev/null | cut -d= -f2-
}

# Read a single key=value field from a conf file
read_conf_field() {
    local file="$1" key="$2"
    grep "^${key}=" "${file}" 2>/dev/null | cut -d= -f2-
}

# Write all per-profile fields to a conf file, preserving display_name.
# Args: file username password token ra_enabled apikey
write_profile_conf() {
    local file="$1" user="$2" pass="$3" token="$4" ra_enabled="$5" apikey="$6"
    local dn
    dn=$(read_conf_field "${file}" "display_name")
    {
        printf 'username=%s\npassword=%s\ntoken=%s\napikey=%s\nra_enabled=%s\n' \
            "${user}" "${pass}" "${token}" "${apikey}" "${ra_enabled}"
        [ -n "${dn}" ] && printf 'display_name=%s\n' "${dn}"
    } > "${file}"
}

# Move a flat pre-profiles folder (saves or states) into the default profile WITHOUT ever risking the player's files.
#   copy (never overwrite what is already there) -> check every file arrived unchanged -> only then RENAME the original to <name>.migrated.
# If any step fails the original is left exactly where it was and a warning is printed.  Nothing is deleted.  Returns 0 when the folder is
# safely migrated (or there was nothing to do), 1 when it was left in place.
verify_copy() {
    local src="$1" dst="$2" f
    while IFS= read -r -d '' f; do
        cmp -s "${src}/${f}" "${dst}/${f}" || return 1
    done < <(cd "${src}" && find . -type f -print0)
    return 0
}
migrate_flat_dir() {
    local src="$1" dst="$2" keep n=0
    if [ -L "${src}" ]; then rm -f "${src}"; return 0; fi      # an old symlink from a pre-profiles install: remove only the link
    [ -d "${src}" ] || return 0
    mkdir -p "${dst}" || { echo "WARNING: cannot create ${dst}; ${src} left in place" >&2; return 1; }
    if ! cp -a -n "${src}/." "${dst}/"; then
        echo "WARNING: copying ${src} failed; it was left in place and nothing was deleted" >&2; return 1
    fi
    if ! verify_copy "${src}" "${dst}"; then
        echo "WARNING: ${src} was not copied completely (or ${dst} already holds a different file of the same name); it was left in place" >&2; return 1
    fi
    keep="${src}.migrated"
    while [ -e "${keep}" ]; do n=$((n+1)); keep="${src}.migrated.${n}"; done
    mv "${src}" "${keep}" || { echo "WARNING: could not rename ${src}; it was left in place" >&2; return 1; }
    echo "Moved ${src} into the default profile; the original is kept as ${keep} (delete it when you are sure)."
}

case "$1" in
    list)
        [ -d "${PROFILES_DIR}" ] && ls "${PROFILES_DIR}" 2>/dev/null || true
        ;;

    current)
        cat "${CURRENT_FILE}" 2>/dev/null || true
        ;;

    create)
        NAME="${2:-}"
        if [ -z "${NAME}" ]; then
            echo "usage: batocera-profiles create <name>" >&2
            exit 1
        fi
        mkdir -p "${PROFILES_DIR}/${NAME}/saves" "${PROFILES_DIR}/${NAME}/states"
        # A new profile starts with NO login: it must never inherit the account of whoever is playing now (each player has their own
        # RetroAchievements account).  It gets a friendly name (what was typed) so it is not labelled by someone else's username, and
        # RetroAchievements is off until its player logs in.
        write_profile_conf \
            "${PROFILES_DIR}/${NAME}/retroachievements.conf" \
            "" "" "" "0" ""
        printf 'display_name=%s\n' "${NAME}" >> "${PROFILES_DIR}/${NAME}/retroachievements.conf"
        echo "Profile '${NAME}' created."
        ;;

    switch)
        NAME="${2:-}"
        if [ -n "${NAME}" ] && [ ! -d "${PROFILES_DIR}/${NAME}" ]; then
            echo "Profile '${NAME}' not found" >&2
            exit 1
        fi

        # --- Save current profile's state before switching ---
        ACTIVE=$(cat "${CURRENT_FILE}" 2>/dev/null || true)
        CUR_USER=$(get_batocera_key "global.retroachievements.username")
        CUR_PASS=$(get_batocera_key "global.retroachievements.password")
        CUR_TOKEN=$(get_batocera_key "global.retroachievements.token")
        CUR_APIKEY=$(get_batocera_key "global.retroachievements.apikey")
        CUR_RA_ENABLED=$(get_batocera_key "global.retroachievements")
        if [ -n "${ACTIVE}" ] && [ -d "${PROFILES_DIR}/${ACTIVE}" ]; then
            write_profile_conf \
                "${PROFILES_DIR}/${ACTIVE}/retroachievements.conf" \
                "${CUR_USER}" "${CUR_PASS}" "${CUR_TOKEN}" "${CUR_RA_ENABLED:-1}" "${CUR_APIKEY}"
        else
            # The first time the default profile gets a settings file, give it a friendly name; otherwise it would be labelled by the
            # RetroAchievements username and look identical to a profile made later.
            DEFAULT_NEW=0; [ -f "${PROFILES_DIR}/.default-retroachievements.conf" ] || DEFAULT_NEW=1
            write_profile_conf \
                "${PROFILES_DIR}/.default-retroachievements.conf" \
                "${CUR_USER}" "${CUR_PASS}" "${CUR_TOKEN}" "${CUR_RA_ENABLED:-1}" "${CUR_APIKEY}"
            [ "${DEFAULT_NEW}" = 1 ] && printf 'display_name=Default\n' >> "${PROFILES_DIR}/.default-retroachievements.conf"
        fi

        # --- One-time migration of pre-profiles saves into .default ---
        # configgen (batoceraPaths.SAVES) reads .batocera-profiles.current directly and sets savefile_directory/savestate_directory per
        # profile.  No symlinks are needed.  The flat /userdata/saves and /userdata/states of a pre-profiles install are moved into
        # .default ONCE (copy, verify, rename: see migrate_flat_dir).  A marker file makes it once: emulators that write straight to
        # /userdata/saves/<name> recreate that folder later, and it must never be swept into .default on every switch.
        mkdir -p "${PROFILES_DIR}/.default/saves" "${PROFILES_DIR}/.default/states"
        MIGRATED_MARK="${PROFILES_DIR}/.flat-folders-migrated"
        PENDING_MARK="${PROFILES_DIR}/.flat-folders-pending"      # a migration was tried and failed: try again at the next switch
        if [ ! -e "${MIGRATED_MARK}" ] && [ -e "${CURRENT_FILE}" ] && [ ! -e "${PENDING_MARK}" ]; then
            # Profiles were already in use before the markers existed (an older version of this script ran its own migration): whatever
            # sits in /userdata/saves now belongs to emulators that write there directly, so it is not ours to move.
            : > "${MIGRATED_MARK}"
        fi
        if [ ! -e "${MIGRATED_MARK}" ]; then
            MIG_OK=1
            migrate_flat_dir "${USERDATA}/saves" "${PROFILES_DIR}/.default/saves" || MIG_OK=0
            migrate_flat_dir "${USERDATA}/states" "${PROFILES_DIR}/.default/states" || MIG_OK=0
            if [ "${MIG_OK}" = 1 ]; then
                : > "${MIGRATED_MARK}"; rm -f "${PENDING_MARK}"
            else
                : > "${PENDING_MARK}"       # the originals are still where they were; the next switch retries
            fi
        fi

        # --- Load target profile's credentials and settings ---
        if [ -n "${NAME}" ] && [ -f "${PROFILES_DIR}/${NAME}/retroachievements.conf" ]; then
            RA_CONF="${PROFILES_DIR}/${NAME}/retroachievements.conf"
        elif [ -z "${NAME}" ] && [ -f "${PROFILES_DIR}/.default-retroachievements.conf" ]; then
            RA_CONF="${PROFILES_DIR}/.default-retroachievements.conf"
        else
            RA_CONF=""
        fi

        if [ -n "${RA_CONF}" ]; then
            RA_USER=$(read_conf_field "${RA_CONF}" "username")
            RA_PASS=$(read_conf_field "${RA_CONF}" "password")
            RA_TOKEN=$(read_conf_field "${RA_CONF}" "token")
            RA_APIKEY=$(read_conf_field "${RA_CONF}" "apikey")
            RA_ENABLED=$(read_conf_field "${RA_CONF}" "ra_enabled")
        else
            RA_USER="" ; RA_PASS="" ; RA_TOKEN="" ; RA_APIKEY="" ; RA_ENABLED=""
        fi

        # Always write username and password, even when empty: a profile without a login must not keep the previous player's account.
        batocera-settings-set global.retroachievements.username "${RA_USER}"
        set_retroarch_key "cheevos_username" "${RA_USER}"
        batocera-settings-set global.retroachievements.password "${RA_PASS}"
        set_retroarch_key "cheevos_password" "${RA_PASS}"
        # Always write token — empty string clears a stale one
        batocera-settings-set global.retroachievements.token "${RA_TOKEN}"
        set_retroarch_key "cheevos_token" "${RA_TOKEN}"
        # Always write the Web API key too: it belongs to the account, so a profile without one must not keep the previous profile's
        # key (RetroAchievements answers 401 for a key that does not match the username).  RetroArch does not use it, only EmulationStation.
        batocera-settings-set global.retroachievements.apikey "${RA_APIKEY}"
        # Restore RA enabled/disabled if the profile has a saved value
        if [ -n "${RA_ENABLED}" ]; then
            batocera-settings-set global.retroachievements "${RA_ENABLED}"
        fi

        echo "${NAME}" > "${CURRENT_FILE}"
        batocera-save-overlay
        echo "Switched to profile '${NAME:-DEFAULT}'."
        ;;

    delete)
        NAME="${2:-}"
        if [ -z "${NAME}" ]; then
            echo "usage: batocera-profiles delete <name>" >&2
            exit 1
        fi
        if [ ! -d "${PROFILES_DIR}/${NAME}" ]; then
            echo "Profile '${NAME}' not found" >&2
            exit 1
        fi
        rm -rf "${PROFILES_DIR}/${NAME}"
        ACTIVE=$(cat "${CURRENT_FILE}" 2>/dev/null || true)
        if [ "${ACTIVE}" = "${NAME}" ]; then
            echo "" > "${CURRENT_FILE}"
        fi
        echo "Profile '${NAME}' deleted."
        ;;

    *)
        echo "usage: batocera-profiles {list|current|create <name>|switch [<name>]|delete <name>}" >&2
        exit 1
        ;;
esac
