#!/bin/sh
# octane-device-password: the first-boot "set a device password" step (docs/security-design-phase1.md, phase 2).
# It reuses Batocera's own mechanism (system.security.enabled, batocera-config setRootPassword, S35securepasswd); it adds only the question.
#   status          prints: set | ask | remind | skipped | declined
#                   ask = show the first-boot question; remind = it was put off and the reminder is due; skipped = put off, not due yet;
#                   declined = the player chose never to be asked again (that is their choice; the Security menu entry still works)
#   set             reads the new password from STANDARD INPUT (so it never sits on a command line for long), checks it, stores it and applies it now
#   skip            "later": ask again in a week (SSH and the share stay on the default "linux" meanwhile)
#   decline         never ask again
#   ask-again       forget everything above (used by the reset file)
# Overrides for tests: OCTANE_S35 (the init script to re-run), OCTANE_NOW (the clock, in seconds), OCTANE_REMIND_DAYS (default 7).
S35="${OCTANE_S35:-/etc/init.d/S35securepasswd}"
MINLEN=8
NOW="${OCTANE_NOW:-$(date +%s)}"; DAYS="${OCTANE_REMIND_DAYS:-7}"
get() { batocera-settings-get "$1" 2>/dev/null; }
case "${1:-}" in
  status)
    if [ "$(get system.security.enabled)" = "1" ]; then echo set
    elif [ "$(get octane.password.declined)" = "1" ]; then echo declined
    elif [ "$(get octane.password.prompted)" = "1" ]; then
      DUE="$(get octane.password.remind_after)"
      case "${DUE}" in ''|*[!0-9]*) echo skipped ;;     # no date (put off by an older version): never nag
        *) if [ "${NOW}" -ge "${DUE}" ]; then echo remind; else echo skipped; fi ;; esac
    else echo ask; fi ;;
  set)
    IFS= read -r PW
    [ "${#PW}" -ge "${MINLEN}" ] || { echo "the password must be at least ${MINLEN} characters" >&2; exit 2; }
    case "${PW}" in *[![:print:]]*) echo "the password may only use printable characters" >&2; exit 2 ;; esac
    batocera-settings-set system.security.enabled 1
    batocera-config setRootPassword "${PW}" || { echo "could not store the password" >&2; exit 1; }
    batocera-settings-set octane.password.prompted 1
    batocera-settings-set octane.password.declined 0
    "${S35}" start >/dev/null 2>&1       # apply now: rebuilds the login and the file-share password, no restart needed
    echo "password set" ;;
  skip) batocera-settings-set octane.password.prompted 1
        batocera-settings-set octane.password.remind_after "$(( NOW + DAYS * 86400 ))"; echo skipped ;;
  decline) batocera-settings-set octane.password.prompted 1; batocera-settings-set octane.password.declined 1; echo declined ;;
  ask-again) batocera-settings-set octane.password.prompted 0; batocera-settings-set octane.password.declined 0
             batocera-settings-set octane.password.remind_after "" ;;
  *) echo "usage: octane-device-password status | set (password on stdin) | skip | decline | ask-again" >&2; exit 2 ;;
esac
