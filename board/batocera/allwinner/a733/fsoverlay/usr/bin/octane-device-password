#!/bin/sh
# octane-device-password: the first-boot "set a device password" step (docs/security-design-phase1.md, phase 2).
# It reuses Batocera's own mechanism (system.security.enabled, batocera-config setRootPassword, S35securepasswd); it adds only the question.
#   status          prints: set | skipped | ask   ("ask" = the first-boot screen should be shown)
#   set             reads the new password from STANDARD INPUT (so it never sits on a command line for long), checks it, stores it and applies it now
#   skip            the player chose not to set one: do not ask again (SSH and the share stay on the default "linux")
#   ask-again       forget that we asked (used by the reset file)
# Overrides for tests: OCTANE_S35 (the init script to re-run).
S35="${OCTANE_S35:-/etc/init.d/S35securepasswd}"
MINLEN=8
get() { batocera-settings-get "$1" 2>/dev/null; }
case "${1:-}" in
  status)
    if [ "$(get system.security.enabled)" = "1" ]; then echo set
    elif [ "$(get octane.password.prompted)" = "1" ]; then echo skipped
    else echo ask; fi ;;
  set)
    IFS= read -r PW
    [ "${#PW}" -ge "${MINLEN}" ] || { echo "the password must be at least ${MINLEN} characters" >&2; exit 2; }
    case "${PW}" in *[![:print:]]*) echo "the password may only use printable characters" >&2; exit 2 ;; esac
    batocera-settings-set system.security.enabled 1
    batocera-config setRootPassword "${PW}" || { echo "could not store the password" >&2; exit 1; }
    batocera-settings-set octane.password.prompted 1
    "${S35}" start >/dev/null 2>&1       # apply now: rebuilds the login and the file-share password, no restart needed
    echo "password set" ;;
  skip) batocera-settings-set octane.password.prompted 1; echo skipped ;;
  ask-again) batocera-settings-set octane.password.prompted 0 ;;
  *) echo "usage: octane-device-password status | set (password on stdin) | skip | ask-again" >&2; exit 2 ;;
esac
